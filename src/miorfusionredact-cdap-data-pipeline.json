{
    "name": "miorfusionredact",
    "description": "Data Pipeline Application",
    "artifact": {
        "name": "cdap-data-pipeline",
        "version": "6.11.1",
        "scope": "SYSTEM"
    },
    "config": {
        "resources": {
            "memoryMB": 2048,
            "virtualCores": 1
        },
        "driverResources": {
            "memoryMB": 2048,
            "virtualCores": 1
        },
        "connections": [
            {
                "from": "GCS",
                "to": "Google DLP Redact"
            },
            {
                "from": "Google DLP Redact",
                "to": "GCS2"
            }
        ],
        "comments": [],
        "postActions": [],
        "properties": {},
        "processTimingEnabled": true,
        "stageLoggingEnabled": false,
        "stages": [
            {
                "name": "GCS",
                "plugin": {
                    "name": "GCSFile",
                    "type": "batchsource",
                    "label": "GCS",
                    "artifact": {
                        "name": "google-cloud",
                        "version": "0.24.1",
                        "scope": "SYSTEM"
                    },
                    "properties": {
                        "useConnection": "false",
                        "project": "auto-detect",
                        "serviceAccountType": "filePath",
                        "serviceFilePath": "auto-detect",
                        "referenceName": "MioGSC",
                        "path": "gs://cloud-training/OCBL167/SampleRecords.csv",
                        "format": "csv",
                        "sampleSize": "1000",
                        "filenameOnly": "false",
                        "recursive": "false",
                        "ignoreNonExistingFolders": "false",
                        "encrypted": "false",
                        "fileEncoding": "UTF-8",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}",
                        "enableQuotedValues": "false",
                        "skipHeader": "false"
                    }
                },
                "outputSchema": [
                    {
                        "name": "etlSchemaBody",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}"
                    }
                ],
                "id": "GCS"
            },
            {
                "name": "Google DLP Redact",
                "plugin": {
                    "name": "SensitiveRecordRedaction",
                    "type": "transform",
                    "label": "Google DLP Redact",
                    "artifact": {
                        "name": "dlp",
                        "version": "1.4.0",
                        "scope": "USER"
                    },
                    "properties": {
                        "customTemplateEnabled": "true",
                        "templateId": "miorfusionredact_template01",
                        "location": "global",
                        "fieldsToTransform": "[\"{\\\"fields\\\":\\\"Notes\\\",\\\"transform\\\":\\\"MASKING\\\",\\\"filters\\\":\\\"NONE\\\",\\\"transformProperties\\\":{\\\"maskingChar\\\":\\\"#\\\",\\\"numberToMask\\\":\\\"0\\\",\\\"reverseOrder\\\":\\\"false\\\",\\\"charsToIgnoreEnum\\\":\\\"COMMON_CHARS_TO_IGNORE_UNSPECIFIED\\\"}}\"]",
                        "serviceFilePath": "auto-detect",
                        "project": "auto-detect"
                    }
                },
                "outputSchema": [
                    {
                        "name": "etlSchemaBody",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}"
                    }
                ],
                "inputSchema": [
                    {
                        "name": "GCS",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}"
                    }
                ],
                "id": "Google-DLP-Redact"
            },
            {
                "name": "GCS2",
                "plugin": {
                    "name": "GCS",
                    "type": "batchsink",
                    "label": "GCS2",
                    "artifact": {
                        "name": "google-cloud",
                        "version": "0.24.1",
                        "scope": "SYSTEM"
                    },
                    "properties": {
                        "useConnection": "false",
                        "project": "auto-detect",
                        "serviceAccountType": "filePath",
                        "serviceFilePath": "auto-detect",
                        "referenceName": "mior_gsc2_sink",
                        "path": "gs://qwiklabs-gcp-03-998e3a5c3286/",
                        "suffix": "yyyy-MM-dd-HH-mm",
                        "format": "csv",
                        "location": "us",
                        "contentType": "application/octet-stream",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}",
                        "writeHeader": "false"
                    }
                },
                "outputSchema": [
                    {
                        "name": "etlSchemaBody",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}"
                    }
                ],
                "inputSchema": [
                    {
                        "name": "Google DLP Redact",
                        "schema": "{\"type\":\"record\",\"name\":\"etlSchemaBody\",\"fields\":[{\"name\":\"Date\",\"type\":[\"string\",\"null\"]},{\"name\":\"Bank\",\"type\":[\"string\",\"null\"]},{\"name\":\"State\",\"type\":[\"string\",\"null\"]},{\"name\":\"Zip\",\"type\":[\"string\",\"null\"]},{\"name\":\"Notes\",\"type\":[\"string\",\"null\"]}]}"
                    }
                ],
                "id": "GCS2"
            }
        ],
        "schedule": "0 1 */1 * *",
        "engine": "spark",
        "numOfRecordsPreview": 100,
        "rangeRecordsPreview": {
            "min": 1,
            "max": "5000"
        },
        "maxConcurrentRuns": 1
    },
    "version": "a3b4f401-d8c8-11f1-af80-ae278777f351"
}